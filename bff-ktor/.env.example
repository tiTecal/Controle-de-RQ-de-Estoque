# ==============================================================================
# API Ponte (BFF Kotlin/Ktor) — Controle de Retirada do Estoque Tecal (TOTVS RM)
# ==============================================================================

# Porta HTTP da API Ponte na rede interna da Tecal
BFF_PORT=8080
BFF_TIMEZONE=America/Sao_Paulo

# Segredo JWT para manter a sessão autenticada do Tablet na porta do almoxarifado
# (Gere uma chave longa e aleatória em Produção!)
BFF_JWT_SECRET=tecal-almoxarifado-jwt-secret-change-in-prod-2026
BFF_JWT_ISSUER=tecal-almoxarifado-bff
BFF_JWT_AUDIENCE=tecal-tablet-kiosk
BFF_JWT_EXPIRATION_HOURS=720

# Modo Simulador (true = simula TOTVS RM em memória para testes; false = conecta no TOTVS RM Real)
RM_MOCK_MODE=true

# Conexão com o Servidor TOTVS RM (RM.Host)
RM_BASE_URL=http://192.168.1.10:8051
RM_COD_COLIGADA=1
RM_COD_SISTEMA_SQL=T
RM_CONTEXT_EXTRA=CODFILIAL=1;CODSISTEMA=T

# Conta de Serviço no TOTVS RM (com permissão de leitura nas 2 Consultas SQL e edição de TMOVCOMPL no 1.1.10)
RM_SERVICE_USER=integracao.almox
RM_SERVICE_PASSWORD=ALTERAR_SENHA_SERVICO

# Códigos das Sentenças SQL cadastradas no wsConsultaSQL do TOTVS RM
RM_SENTENCA_PENDENTES=TECAL.ALM.1110_PENDENTES
RM_SENTENCA_ITENS=TECAL.ALM.1110_ITENS

# Nomes exatos das colunas complementares na tabela TMOVCOMPL do movimento 1.1.10
RM_COL_RETIRADO_POR=RETIRADO_POR
RM_COL_DATA_RETIRADA=DATA_RETIRADA
RM_COL_HORA_RETIRADA=HORA_RETIRADA

# Formato da data gravada em DATA_RETIRADA (yyyy-MM-dd para VARCHAR/DATE ou yyyy-MM-dd'T'00:00:00 para DATETIME XML do RM)
RM_DATA_RETIRADA_PATTERN=yyyy-MM-dd

