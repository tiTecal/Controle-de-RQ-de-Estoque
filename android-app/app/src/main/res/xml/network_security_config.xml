<?xml version="1.0" encoding="utf-8"?>
<!-- Permite comunicação na rede local interna (LAN) da Tecal entre o Tablet e o BFF interno -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

