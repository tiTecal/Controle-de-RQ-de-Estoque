# ==============================================================================
# API Ponte (BFF Node.js/TypeScript) — Controle de Retirada do Estoque Tecal (SQL Server)
# ==============================================================================

# Porta HTTP da API Ponte na rede interna da Tecal
BFF_PORT=7777
BFF_TIMEZONE=America/Sao_Paulo

# Segredo JWT para manter a sessão autenticada do Tablet na porta do almoxarifado
# (Gere uma chave longa e aleatória em Produção!)
BFF_JWT_SECRET=tecal-almoxarifado-jwt-secret-change-in-prod-2026
BFF_JWT_ISSUER=tecal-almoxarifado-bff
BFF_JWT_AUDIENCE=tecal-tablet-kiosk
BFF_JWT_EXPIRATION_HOURS=720

# Modo Simulador (true = simula em memória para testes; false = conecta no SQL Server Real)
RM_MOCK_MODE=false

# Conexão Direta com o SQL Server (Bases Corpore e ALMOXARIFADO)
DB_HOST=192.168.7.7
DB_PORT=1433
DB_USER=almoxarife
DB_PASSWORD=ALTERAR_SENHA_BANCO
DB_CORPORE_NAME=Corpore
DB_ALMOX_NAME=ALMOXARIFADO
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Parâmetros de Negócio na Base Corpore (TOTVS RM)
RM_COD_COLIGADA=2
# Filtro opcional de corte histórico (YYYY-MM-DD) para não listar movimentos 1.1.10 antigos do legado
RM_MIN_DATA_EMISSAO=2026-01-01

# Nomes exatos das colunas complementares na tabela Corpore.dbo.TMOVCOMPL do movimento 1.1.10
RM_COL_RETIRADO_POR=RETIRADO_POR
RM_COL_DATA_RETIRADA=DATA_RETIRADA
RM_COL_HORA_RETIRADA=HORA_RETIRADA

# Formato da data gravada em DATA_RETIRADA (yyyy-MM-dd)
RM_DATA_RETIRADA_PATTERN=yyyy-MM-dd
